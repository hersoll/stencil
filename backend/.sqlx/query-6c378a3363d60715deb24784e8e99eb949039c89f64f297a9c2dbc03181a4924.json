{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.name, t.desc_sv, t.desc_en, ct.chapter_id\n        FROM topics t\n        JOIN chapter_topics ct ON t.id = ct.topic_id\n        WHERE ct.chapter_id = ANY($1)\n        AND (NOT $2::bool OR t.public)\n        ORDER BY ct.chapter_id, ct.order_index, t.name",
