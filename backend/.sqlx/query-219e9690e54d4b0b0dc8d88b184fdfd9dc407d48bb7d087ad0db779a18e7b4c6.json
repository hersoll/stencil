  "query": "SELECT ch.id, ch.name, ch.desc_sv, ch.desc_en\n        FROM chapters ch\n        JOIN course_chapters cc ON ch.id = cc.chapter_id\n        WHERE cc.course_id = $1\n        AND (NOT $2::bool OR ch.public)\n        ORDER BY cc.order_index, ch.name",
