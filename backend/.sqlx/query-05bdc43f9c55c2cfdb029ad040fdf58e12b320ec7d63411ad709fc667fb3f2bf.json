{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.name, t.desc_sv, t.desc_en, t.public,\n            (created_at >= NOW() - $2::interval) AS \"is_new!\"\n        FROM topics t\n        JOIN UNNEST($1::int[]) WITH ORDINALITY AS u(id, ord) ON t.id = u.id\n        ORDER BY u.ord",
