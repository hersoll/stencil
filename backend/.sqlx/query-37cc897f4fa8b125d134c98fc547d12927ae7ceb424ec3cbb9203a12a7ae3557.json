{
  "db_name": "PostgreSQL",
  "query": "SELECT t.id, t.name, t.desc_sv, t.desc_en, t.public,\n            (created_at >= NOW() - $2::interval AND created_at >= DATE '2026-08-17') AS \"is_new!\"\n        FROM topics t\n        JOIN topic_problems tp ON t.id = tp.topic_id\n        WHERE tp.problem_id = $1",
