{
  "db_name": "PostgreSQL",
  "query": "SELECT c.id, c.name, c.desc_sv, c.desc_en, c.public,\n            (created_at >= NOW() - $2::interval AND created_at >= DATE '2026-08-17') AS \"is_new!\"\n        FROM chapters c\n        JOIN chapter_topics ct ON c.id = ct.chapter_id\n        WHERE ct.topic_id = $1\n        ORDER BY c.name",
