  "query": "SELECT co.id, co.name, co.desc_sv, co.desc_en\n        FROM courses co\n        JOIN course_chapters coch ON co.id = coch.course_id\n        WHERE coch.chapter_id = $1\n        ORDER BY coch.order_index, co.name",
