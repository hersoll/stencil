{
  "db_name": "PostgreSQL",
  "query": "SELECT p.id AS problem_id, tp.relative_difficulty, tp.absolute_difficulty, tp.topic_id \n        FROM problems p\n        JOIN topic_problems tp ON p.id = tp.problem_id\n        WHERE tp.topic_id = ANY($1)\n          AND NOT p.id = ANY($2)\n          AND tp.absolute_difficulty = ANY($3)",
